    "logicTrigger" : "VIEWEVENT",
    "logicType" : "SCRIPT",
    "name" : "created",
    "scriptCode" : "\n\nvar cview = view;\nvar nview = view\nwhile(cview && cview.name.indexOf('ai_agent_assignment')>=0 && cview.parentView) {\n    nview = cview;\n    cview=cview.parentView;\n}\n\nconsole.log('parentData父视图数据为：', nview.parentData)\nview.params.n_compose_id_eq=view.parentView.context.n_compose_id_eq;\nview.context.n_compose_id_eq=view.parentView.context.n_compose_id_eq;\nview.context._entity_row_key=view.parentView.context._entity_row_key;\nview.context._entity_tag=view.parentView.context._entity_tag;\n\nif(!view.params.n_compose_id_eq && view && cview) {\n    \n    const appDataEntityId=cview.model.appDataEntityId;\n    if(appDataEntityId && appDataEntityId.indexOf(\".\")>0) {\n        var _entity_tag=appDataEntityId.split(\".\")[1];\n        view.context._entity_tag=_entity_tag;\n\n        var _entity_row_key = '';\n \n        if(!_entity_row_key && view.context[_entity_tag])  {\n            _entity_row_key=view.context[_entity_tag];\n        }\n        if(nview.parentData &&  nview.parentData && nview.parentData.length > 0 && nview.parentData[0].id )  {\n            if(!_entity_row_key ) {\n                _entity_row_key = nview.parentData[0].id;\n            } \n        } \n        if(!_entity_row_key ) {\n            _entity_row_key = view.params.n_use_tag_like;\n        }\n        var profile = view.context.profile;\n        if(profile) {\n            profile=\":\"+profile+\":\";\n        }\n        else {\n            profile=\":row:\";\n        }\n        var n_compose_id_eq = _entity_tag+profile+_entity_row_key;\n        view.params.n_compose_id_eq=n_use_tag_like;\n        view.context.n_compose_id_eq=n_use_tag_like;\n        view.context._entity_row_key=_entity_row_key;\n    }\n    if(!view.params.n_compose_id_eq )\n    {\n        view.params.n_compose_id_eq='NA';\n    }\n}"
