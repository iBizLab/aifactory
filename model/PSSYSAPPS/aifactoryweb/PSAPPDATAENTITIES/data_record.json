    "name" : "chat_resource",
    "reportFile" : "#",
    "reportModel" : "<#-- 1. 顶层循环保持不变 -->\n<#list data as body>\n    <#assign schema = body._schema!{}>\n    <#assign dataSource = body._metadata!{}>\n    <#if schema.definition?? && body.resource_name??>\n\n# <#if body.title??>${body.title}<#else>${body.resource_name}</#if>\n\n<@properties maps=schema.definition.properties!{} contents=dataSource level=2 parentName=schema.definition.name!\"root\"/>\n    </#if>\n</#list>\n<#macro properties maps contents parentName level>\n<#local titleLevel = (level > 6)?then(6, level) /><#local hashes = \"\" /><#list 1..titleLevel as i><#local hashes = hashes + \"#\" /></#list>\n\n<#-- 1. 关键修复：表格上方必须有一个绝对的空行，且必须有一行文字表头 -->\n\n<#--| - | - | - | - | - | - | -->\n<#--|:---:|:---:|:---:|:---:|:---:|:---:|-->\n<#local col = 0><#list maps?keys as key><#t>\n<#local definition = maps[key]!><#t>\n<#-- 过滤逻辑 -->\n<#if key?upper_case?ends_with(\"_DM\")><#t>\n    <#local baseKey = key?upper_case?keep_before_last(\"_DM\")><#t>\n    <#if maps[baseKey + \"_SHOW\"]?? || maps[baseKey?lower_case + \"_show\"]?? || maps[baseKey + \"DM_SHOW\"]?? || maps[baseKey?lower_case + \"dm_show\"]?? || maps[baseKey + \"_MC\"]?? || maps[baseKey?lower_case + \"_mc\"]??><#continue></#if><#t>\n</#if><#t>\n<#if definition?is_hash && definition.type??><#t>\n<#local schemaKey = definition.name!key /><#t>\n<#local realKey = \"\"><#list contents?keys as cKey><#if cKey?upper_case == schemaKey?upper_case><#local realKey = cKey><#break></#if></#list><#t>\n<#if realKey != \"\"><#t>\n<#local value = contents[realKey]!><#t>\n<#-- === 基础字段处理 === -->\n<#if definition.type == \"string\" || definition.type == \"number\"><#t>\n    <#if !value?is_hash><#t>\n        <#local strValue = (definition.enumsource?? && definition.enumsource == 'YesNoDict')?then((value?string == \"0\")?then(\"否\", \"是\"), value?is_number?then(value?c, value?is_date?then(value?string(\"yyyy-MM-dd HH:mm:ss\"), value?string!\"[空]\")))>\n        <#local strValue = strValue?replace(\"\\n\", \" \")?replace(\"\\r\", \"\")?replace(\"|\", \"&#124;\")?trim><#t>\n        <#local isLong = (strValue?length > 40)><#t>\n        <#if isLong><#t>\n            <#if col != 0><#list col..5 as i> 　</#list>${'\\n'}</#if><#t>\n　 **${definition.title!schemaKey}** 　 ${strValue} 　 　 　 　 　${'\\n'}<#local col = 0><#t>\n        <#else><#t>\n            <#if col == 0>　 <#else> </#if>**${definition.title!schemaKey}** 　 ${strValue} 　<#t>\n            <#local col = col + 2><#t>\n            <#if col == 6><#local col = 0>${'\\n'}</#if><#t>\n        </#if><#t>\n    </#if><#t>\n<#-- === 对象和数组处理 (跳出表格) === -->\n<#elseif (definition.type == \"object\" || definition.type == \"array\")><#t>\n    <#if col != 0><#list col..5 as i> 　</#list>${'\\n'}</#if><#local col = 0><#t>\n    <#if definition.type == \"object\" && value?is_hash><#t>\n\n${hashes} ${(definition.title!schemaKey)?replace(\"表(\", \"(\")}\n<@properties maps=definition.properties!{} contents=value parentName=parentName + \".\" + schemaKey level=level+1/>\n    <#elseif definition.type == \"array\" && value?is_sequence && value?size gt 0><#t>\n\n${hashes} ${(definition.title!schemaKey)?replace(\"明细\", \"\")}\n        <#if definition.items?? && definition.items?is_hash><#t>\n            <#list value as item><#t>\n                <#if item?is_hash><#t>\n\n${hashes}# ${(definition.title!schemaKey)?replace(\"明细\", \"\")} ${item_index + 1}\n<@properties maps=definition.items.properties!{} contents=item parentName=parentName + \".\" + schemaKey + (item_index + 1) level=level+2/>\n                </#if><#t>\n            </#list><#t>\n        </#if><#t>\n    </#if><#t>\n</#if><#t>\n</#if><#t>\n</#if><#t>\n</#list><#t>\n<#if col != 0><#list col..5 as i> 　</#list></#if>\n\n</#macro>",
    "reportType" : "CHATRESOURCE"
  } ],
