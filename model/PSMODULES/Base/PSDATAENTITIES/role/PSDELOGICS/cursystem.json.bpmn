        <process id="cn.ibizlab.core.base.service.logic.rolecursystem" isClosed="false" isExecutable="true" name="base_role_cursystem_ruleFlow" processType="Private" tns:packageName="cn.ibizlab.core.base.service.logic.rolecursystem">
