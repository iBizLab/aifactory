<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
    <definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:activiti="http://activiti.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:g="http://www.jboss.org/drools/flow/gpd" xmlns:tns="http://www.jboss.org/drools" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" expressionLanguage="http://www.mvel.org/2.0" id="Definition" name="" targetNamespace="http://www.jboss.org/drools" typeLanguage="http://www.java.com/javaTypes">
        <process id="cn.ibizlab.core.ai.service.logic.ai_model_providerget_ai_default_credential" isClosed="false" isExecutable="true" name="ai_ai_model_provider_get_ai_default_credential_ruleFlow" processType="Private" tns:packageName="cn.ibizlab.core.ai.service.logic.ai_model_providerget_ai_default_credential">
            <extensionElements>
                <tns:import name="java.util.Map" />
                <tns:import name="org.springframework.util.StringUtils"/>
                <tns:import name="cn.ibizlab.util.helper.RuleUtils"/>
                                <tns:metaData express="" name="ai_model_providerget_ai_default_credentialdefault" type="entity"/>
                                <tns:metaData express="new cn.ibizlab.core.ai.domain.ai_credential()" name="ai_model_providerget_ai_default_credentialcredential" type="refentity"/>
                                <tns:metaData express="new cn.ibizlab.core.ai.domain.ai_credential()" name="ai_model_providerget_ai_default_credentialcredential_filter" type="refentity"/>
                                <tns:metaData express="new cn.ibizlab.core.ai.domain.ai_credential()" name="ai_model_providerget_ai_default_credentialcredentials" type="refentity"/>
                                    <tns:metaData express="T(cn.ibizlab.util.security.SpringContextHolder).getBean(T(cn.ibizlab.core.ai.service.Iai_credentialService))" name="ai_credentialservice" type="service"/>
                    <tns:metaData express="T(cn.ibizlab.util.security.SpringContextHolder).getBean(T(cn.ibizlab.core.ai.service.Iai_model_providerService))" name="iBzSysAi_model_providerDefaultService" type="service"/>
                    <tns:metaData express="T(cn.ibizlab.util.security.AuthenticationUser).getAuthenticationUser()" name="curuser" type="session"/>
                            <tns:global identifier="ai_model_providerget_ai_default_credentialdefault" type="cn.ibizlab.core.ai.domain.ai_model_provider" />
                            <tns:global identifier="ai_model_providerget_ai_default_credentialcredential" type="cn.ibizlab.core.ai.domain.ai_credential" />
                            <tns:global identifier="ai_model_providerget_ai_default_credentialcredential_filter" type="cn.ibizlab.core.ai.domain.ai_credential" />
                            <tns:global identifier="ai_model_providerget_ai_default_credentialcredentials" type="cn.ibizlab.core.ai.domain.ai_credential" />
            </extensionElements>
                        <startEvent id="begin" isInterrupting="true"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_model_providerget_ai_default_credentialdeaction_03" id="deaction_03" implementation="http://www.jboss.org/drools/rule" name="获取凭证"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_model_providerget_ai_default_credentialdedataset_01" id="dedataset_01" implementation="http://www.jboss.org/drools/rule" name="提供商是否已存在"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_model_providerget_ai_default_credentialend_01" id="end_01" implementation="http://www.jboss.org/drools/rule" name="结束"/>
                        <endEvent id="end_01_end" name="end"/>
                        <sequenceFlow id="end_01_end_line" sourceRef="end_01" targetRef="end_01_end"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_model_providerget_ai_default_credentialprepareparam_01" id="prepareparam_01" implementation="http://www.jboss.org/drools/rule" name="准备参数"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_model_providerget_ai_default_credentialprepareparam_03" id="prepareparam_03" implementation="http://www.jboss.org/drools/rule" name="准备参数"/>
                    <sequenceFlow id="begin_prepareparam_01" sourceRef="begin" targetRef="prepareparam_01">
                    </sequenceFlow>
                    <sequenceFlow id="deaction_03_prepareparam_03" sourceRef="deaction_03" targetRef="prepareparam_03">
                    </sequenceFlow>
                    <sequenceFlow id="gateway-dedataset_01_deaction_03" sourceRef="gateway-dedataset_01" targetRef="deaction_03">
                            <conditionExpression  language="http://www.jboss.org/drools/rule" ><![CDATA[
                                            $ai_model_providerget_ai_default_credentialdefault:ai_model_provider();
                                            $ai_model_providerget_ai_default_credentialcredential:ai_credential();
                                            $ai_model_providerget_ai_default_credentialcredential_filter:ai_credential();
                                            $ai_model_providerget_ai_default_credentialcredentials:ai_credential();
                                    eval($ai_model_providerget_ai_default_credentialdefault==ai_model_providerget_ai_default_credentialdefault && $ai_model_providerget_ai_default_credentialcredential==ai_model_providerget_ai_default_credentialcredential && $ai_model_providerget_ai_default_credentialcredential_filter==ai_model_providerget_ai_default_credentialcredential_filter && $ai_model_providerget_ai_default_credentialcredentials==ai_model_providerget_ai_default_credentialcredentials);
                                eval((RuleUtils.test($ai_model_providerget_ai_default_credentialcredentials.get("size"),"GT","0")))
                                ]]>
                            </conditionExpression>
                    </sequenceFlow>
                    <sequenceFlow id="prepareparam_01_dedataset_01" sourceRef="prepareparam_01" targetRef="dedataset_01">
                    </sequenceFlow>
                    <sequenceFlow id="prepareparam_03_end_01" sourceRef="prepareparam_03" targetRef="end_01">
                    </sequenceFlow>
                            <exclusiveGateway id="gateway-dedataset_01" name="Gateway" gatewayDirection="Diverging" default="gateway-dedataset_01_end_line"></exclusiveGateway>
                            <sequenceFlow id="dedataset_01_gateway-dedataset_01_gatewayline" sourceRef="dedataset_01" targetRef="gateway-dedataset_01"></sequenceFlow>
                            <sequenceFlow id="gateway-dedataset_01_end_line" sourceRef="gateway-dedataset_01" targetRef="gateway-dedataset_01_end"/>
                            <endEvent id="gateway-dedataset_01_end" name="end"/>
        </process>
