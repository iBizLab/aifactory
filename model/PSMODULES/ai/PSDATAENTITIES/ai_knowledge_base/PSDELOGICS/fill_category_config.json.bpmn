<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
    <definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:activiti="http://activiti.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:g="http://www.jboss.org/drools/flow/gpd" xmlns:tns="http://www.jboss.org/drools" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" expressionLanguage="http://www.mvel.org/2.0" id="Definition" name="" targetNamespace="http://www.jboss.org/drools" typeLanguage="http://www.java.com/javaTypes">
        <process id="cn.ibizlab.core.ai.service.logic.ai_knowledge_basefill_category_config" isClosed="false" isExecutable="true" name="ai_ai_knowledge_base_fill_category_config_ruleFlow" processType="Private" tns:packageName="cn.ibizlab.core.ai.service.logic.ai_knowledge_basefill_category_config">
            <extensionElements>
                <tns:import name="java.util.Map" />
                <tns:import name="org.springframework.util.StringUtils"/>
                <tns:import name="cn.ibizlab.util.helper.RuleUtils"/>
                                <tns:metaData express="" name="ai_knowledge_basefill_category_configdefault" type="entity"/>
                                <tns:metaData express="new cn.ibizlab.core.base.domain.category()" name="ai_knowledge_basefill_category_configcategory" type="refentity"/>
                                <tns:metaData express="new cn.ibizlab.core.base.domain.category_settings()" name="ai_knowledge_basefill_category_configsetting" type="refentity"/>
                                    <tns:metaData express="T(cn.ibizlab.util.security.SpringContextHolder).getBean(T(cn.ibizlab.core.base.service.IcategoryService))" name="categoryservice" type="service"/>
                    <tns:metaData express="T(cn.ibizlab.util.security.SpringContextHolder).getBean(T(cn.ibizlab.core.ai.service.Iai_knowledge_baseService))" name="iBzSysAi_knowledge_baseDefaultService" type="service"/>
                    <tns:metaData express="T(cn.ibizlab.util.security.AuthenticationUser).getAuthenticationUser()" name="curuser" type="session"/>
                            <tns:global identifier="ai_knowledge_basefill_category_configdefault" type="cn.ibizlab.core.ai.domain.ai_knowledge_base" />
                            <tns:global identifier="ai_knowledge_basefill_category_configcategory" type="cn.ibizlab.core.base.domain.category" />
                            <tns:global identifier="ai_knowledge_basefill_category_configsetting" type="cn.ibizlab.core.base.domain.category_settings" />
            </extensionElements>
                        <startEvent id="begin" isInterrupting="true"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_knowledge_basefill_category_configprepareparam_01" id="prepareparam_01" implementation="http://www.jboss.org/drools/rule" name="获取选择的分类ID"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_knowledge_basefill_category_configdeaction_01" id="deaction_01" implementation="http://www.jboss.org/drools/rule" name="查询分类配置"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_knowledge_basefill_category_configend_01" id="end_01" implementation="http://www.jboss.org/drools/rule" name="结束"/>
                        <endEvent id="end_01_end" name="end"/>
                        <sequenceFlow id="end_01_end_line" sourceRef="end_01" targetRef="end_01_end"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_knowledge_basefill_category_configprepareparam_03" id="prepareparam_03" implementation="http://www.jboss.org/drools/rule" name="填充分类配置"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_knowledge_basefill_category_configcopyparam_01" id="copyparam_01" implementation="http://www.jboss.org/drools/rule" name="拷贝参数"/>
                    <sequenceFlow id="begin_prepareparam_01" sourceRef="begin" targetRef="prepareparam_01">
                    </sequenceFlow>
                    <sequenceFlow id="gateway-prepareparam_01_deaction_01" sourceRef="gateway-prepareparam_01" targetRef="deaction_01">
                            <conditionExpression  language="http://www.jboss.org/drools/rule" ><![CDATA[
                                            $ai_knowledge_basefill_category_configdefault:ai_knowledge_base();
                                            $ai_knowledge_basefill_category_configcategory:category();
                                            $ai_knowledge_basefill_category_configsetting:category_settings();
                                    eval($ai_knowledge_basefill_category_configdefault==ai_knowledge_basefill_category_configdefault && $ai_knowledge_basefill_category_configcategory==ai_knowledge_basefill_category_configcategory && $ai_knowledge_basefill_category_configsetting==ai_knowledge_basefill_category_configsetting);
                                eval((RuleUtils.test($ai_knowledge_basefill_category_configcategory.get("id"),"ISNOTNULL","")))
                                ]]>
                            </conditionExpression>
                    </sequenceFlow>
                    <sequenceFlow id="gateway-deaction_01_prepareparam_03" sourceRef="gateway-deaction_01" targetRef="prepareparam_03">
                            <conditionExpression  language="http://www.jboss.org/drools/rule" ><![CDATA[
                                            $ai_knowledge_basefill_category_configdefault:ai_knowledge_base();
                                            $ai_knowledge_basefill_category_configcategory:category();
                                            $ai_knowledge_basefill_category_configsetting:category_settings();
                                    eval($ai_knowledge_basefill_category_configdefault==ai_knowledge_basefill_category_configdefault && $ai_knowledge_basefill_category_configcategory==ai_knowledge_basefill_category_configcategory && $ai_knowledge_basefill_category_configsetting==ai_knowledge_basefill_category_configsetting);
                                eval((RuleUtils.test($ai_knowledge_basefill_category_configcategory.get("setting"),"ISNOTNULL","")))
                                ]]>
                            </conditionExpression>
                    </sequenceFlow>
                    <sequenceFlow id="prepareparam_03_copyparam_01" sourceRef="prepareparam_03" targetRef="copyparam_01">
                    </sequenceFlow>
                    <sequenceFlow id="copyparam_01_end_01" sourceRef="copyparam_01" targetRef="end_01">
                    </sequenceFlow>
                            <exclusiveGateway id="gateway-prepareparam_01" name="Gateway" gatewayDirection="Diverging" default="gateway-prepareparam_01_end_line"></exclusiveGateway>
                            <sequenceFlow id="prepareparam_01_gateway-prepareparam_01_gatewayline" sourceRef="prepareparam_01" targetRef="gateway-prepareparam_01"></sequenceFlow>
                            <sequenceFlow id="gateway-prepareparam_01_end_line" sourceRef="gateway-prepareparam_01" targetRef="gateway-prepareparam_01_end"/>
                            <endEvent id="gateway-prepareparam_01_end" name="end"/>
                            <exclusiveGateway id="gateway-deaction_01" name="Gateway" gatewayDirection="Diverging" default="gateway-deaction_01_end_line"></exclusiveGateway>
                            <sequenceFlow id="deaction_01_gateway-deaction_01_gatewayline" sourceRef="deaction_01" targetRef="gateway-deaction_01"></sequenceFlow>
                            <sequenceFlow id="gateway-deaction_01_end_line" sourceRef="gateway-deaction_01" targetRef="gateway-deaction_01_end"/>
                            <endEvent id="gateway-deaction_01_end" name="end"/>
        </process>
    </definitions>