<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
    <definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:activiti="http://activiti.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:g="http://www.jboss.org/drools/flow/gpd" xmlns:tns="http://www.jboss.org/drools" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" expressionLanguage="http://www.mvel.org/2.0" id="Definition" name="" targetNamespace="http://www.jboss.org/drools" typeLanguage="http://www.java.com/javaTypes">
        <process id="cn.ibizlab.core.ai.service.logic.ai_knowledge_basecalc_parsed_cnt" isClosed="false" isExecutable="true" name="ai_ai_knowledge_base_calc_parsed_cnt_ruleFlow" processType="Private" tns:packageName="cn.ibizlab.core.ai.service.logic.ai_knowledge_basecalc_parsed_cnt">
            <extensionElements>
                <tns:import name="java.util.Map" />
                <tns:import name="org.springframework.util.StringUtils"/>
                <tns:import name="cn.ibizlab.util.helper.RuleUtils"/>
                                <tns:metaData express="" name="ai_knowledge_basecalc_parsed_cntdefault" type="entity"/>
                                <tns:metaData express="new cn.ibizlab.core.ai.domain.ai_knowledge_base()" name="ai_knowledge_basecalc_parsed_cntgd" type="refentity"/>
                                    <tns:metaData express="T(cn.ibizlab.util.security.SpringContextHolder).getBean(T(cn.ibizlab.core.ai.service.Iai_knowledge_baseService))" name="ai_knowledge_baseservice" type="service"/>
                    <tns:metaData express="T(cn.ibizlab.util.security.SpringContextHolder).getBean(T(cn.ibizlab.core.ai.service.Iai_knowledge_baseService))" name="iBzSysAi_knowledge_baseDefaultService" type="service"/>
                    <tns:metaData express="T(cn.ibizlab.util.security.AuthenticationUser).getAuthenticationUser()" name="curuser" type="session"/>
                            <tns:global identifier="ai_knowledge_basecalc_parsed_cntdefault" type="cn.ibizlab.core.ai.domain.ai_knowledge_base" />
                            <tns:global identifier="ai_knowledge_basecalc_parsed_cntgd" type="cn.ibizlab.core.ai.domain.ai_knowledge_base" />
            </extensionElements>
                        <startEvent id="begin" isInterrupting="true"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_knowledge_basecalc_parsed_cntprepareparam_01" id="prepareparam_01" implementation="http://www.jboss.org/drools/rule" name="准备参数"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_knowledge_basecalc_parsed_cntrawsqlcall_01" id="rawsqlcall_01" implementation="http://www.jboss.org/drools/rule" name="AI_KB_DOCUMENT数量"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_knowledge_basecalc_parsed_cntdelogic_01" id="delogic_01" implementation="http://www.jboss.org/drools/rule" name="生成引导词"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_knowledge_basecalc_parsed_cntprepareparam_02" id="prepareparam_02" implementation="http://www.jboss.org/drools/rule" name="准备参数"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_knowledge_basecalc_parsed_cntend_01" id="end_01" implementation="http://www.jboss.org/drools/rule" name="结束"/>
                        <endEvent id="end_01_end" name="end"/>
                        <sequenceFlow id="end_01_end_line" sourceRef="end_01" targetRef="end_01_end"/>
                    <sequenceFlow id="begin_rawsqlcall_01" sourceRef="begin" targetRef="rawsqlcall_01">
                    </sequenceFlow>
                    <sequenceFlow id="prepareparam_01_delogic_01" sourceRef="prepareparam_01" targetRef="delogic_01">
                    </sequenceFlow>
                    <sequenceFlow id="gateway-rawsqlcall_01_prepareparam_01" sourceRef="gateway-rawsqlcall_01" targetRef="prepareparam_01">
                            <conditionExpression  language="http://www.jboss.org/drools/rule" ><![CDATA[
                                            $ai_knowledge_basecalc_parsed_cntdefault:ai_knowledge_base();
                                            $ai_knowledge_basecalc_parsed_cntgd:ai_knowledge_base();
                                    eval($ai_knowledge_basecalc_parsed_cntdefault==ai_knowledge_basecalc_parsed_cntdefault && $ai_knowledge_basecalc_parsed_cntgd==ai_knowledge_basecalc_parsed_cntgd);
                                eval((RuleUtils.test($ai_knowledge_basecalc_parsed_cntdefault.get("parsedCnt"),"EQ","document_cnt")))
                                ]]>
                            </conditionExpression>
                    </sequenceFlow>
                    <sequenceFlow id="rawsqlcall_01_end_01" sourceRef="rawsqlcall_01" targetRef="end_01">
                    </sequenceFlow>
                    <sequenceFlow id="delogic_01_prepareparam_02" sourceRef="delogic_01" targetRef="prepareparam_02">
                    </sequenceFlow>
                    <sequenceFlow id="prepareparam_02_end_01" sourceRef="prepareparam_02" targetRef="end_01">
                    </sequenceFlow>
                            <exclusiveGateway id="gateway-rawsqlcall_01" name="Gateway" gatewayDirection="Diverging" default="gateway-rawsqlcall_01_end_line"></exclusiveGateway>
                            <sequenceFlow id="rawsqlcall_01_gateway-rawsqlcall_01_gatewayline" sourceRef="rawsqlcall_01" targetRef="gateway-rawsqlcall_01"></sequenceFlow>
                            <sequenceFlow id="gateway-rawsqlcall_01_end_line" sourceRef="gateway-rawsqlcall_01" targetRef="gateway-rawsqlcall_01_end"/>
                            <endEvent id="gateway-rawsqlcall_01_end" name="end"/>
        </process>
    </definitions>