<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
    <definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:activiti="http://activiti.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:g="http://www.jboss.org/drools/flow/gpd" xmlns:tns="http://www.jboss.org/drools" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" expressionLanguage="http://www.mvel.org/2.0" id="Definition" name="" targetNamespace="http://www.jboss.org/drools" typeLanguage="http://www.java.com/javaTypes">
        <process id="cn.ibizlab.core.ai.service.logic.ai_knowledge_baseget_by_code" isClosed="false" isExecutable="true" name="ai_ai_knowledge_base_get_by_code_ruleFlow" processType="Private" tns:packageName="cn.ibizlab.core.ai.service.logic.ai_knowledge_baseget_by_code">
            <extensionElements>
                <tns:import name="java.util.Map" />
                <tns:import name="org.springframework.util.StringUtils"/>
                <tns:import name="cn.ibizlab.util.helper.RuleUtils"/>
                                <tns:metaData express="" name="ai_knowledge_baseget_by_codedefault" type="entity"/>
                                <tns:metaData express="new cn.ibizlab.core.ai.domain.ai_knowledge_base()" name="ai_knowledge_baseget_by_codefilter" type="refentity"/>
                                <tns:metaData express="new HashMap()" name="ai_knowledge_baseget_by_codekbids" type="refentity"/>
                                    <tns:metaData express="T(cn.ibizlab.util.security.SpringContextHolder).getBean(T(cn.ibizlab.core.ai.service.Iai_knowledge_baseService))" name="ai_knowledge_baseservice" type="service"/>
                    <tns:metaData express="T(cn.ibizlab.util.security.SpringContextHolder).getBean(T(cn.ibizlab.core.ai.service.Iai_knowledge_baseService))" name="iBzSysAi_knowledge_baseDefaultService" type="service"/>
                    <tns:metaData express="T(cn.ibizlab.util.security.AuthenticationUser).getAuthenticationUser()" name="curuser" type="session"/>
                            <tns:global identifier="ai_knowledge_baseget_by_codedefault" type="cn.ibizlab.core.ai.domain.ai_knowledge_base" />
                            <tns:global identifier="ai_knowledge_baseget_by_codefilter" type="cn.ibizlab.core.ai.domain.ai_knowledge_base" />
            </extensionElements>
                        <startEvent id="begin" isInterrupting="true"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_knowledge_baseget_by_coderawsfcode_01" id="rawsfcode_01" implementation="http://www.jboss.org/drools/rule" name="执行脚本代码"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_knowledge_baseget_by_codedeaction_01" id="deaction_01" implementation="http://www.jboss.org/drools/rule" name="实体行为"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_knowledge_baseget_by_codeend_01" id="end_01" implementation="http://www.jboss.org/drools/rule" name="结束"/>
                        <endEvent id="end_01_end" name="end"/>
                        <sequenceFlow id="end_01_end_line" sourceRef="end_01" targetRef="end_01_end"/>
                    <sequenceFlow id="begin_rawsfcode_01" sourceRef="begin" targetRef="rawsfcode_01">
                    </sequenceFlow>
                    <sequenceFlow id="rawsfcode_01_end_01" sourceRef="rawsfcode_01" targetRef="end_01">
                    </sequenceFlow>
                    <sequenceFlow id="gateway-rawsfcode_01_deaction_01" sourceRef="gateway-rawsfcode_01" targetRef="deaction_01">
                            <conditionExpression  language="http://www.jboss.org/drools/rule" ><![CDATA[
                                            $ai_knowledge_baseget_by_codedefault:ai_knowledge_base();
                                            $ai_knowledge_baseget_by_codefilter:ai_knowledge_base();
                                            $ai_knowledge_baseget_by_codekbids:Map();
                                    eval($ai_knowledge_baseget_by_codedefault==ai_knowledge_baseget_by_codedefault && $ai_knowledge_baseget_by_codefilter==ai_knowledge_baseget_by_codefilter && );
                                eval((RuleUtils.test($ai_knowledge_baseget_by_codedefault.get("id"),"ISNOTNULL","")))
                                ]]>
                            </conditionExpression>
                    </sequenceFlow>
                    <sequenceFlow id="deaction_01_end_01" sourceRef="deaction_01" targetRef="end_01">
                    </sequenceFlow>
                            <exclusiveGateway id="gateway-rawsfcode_01" name="Gateway" gatewayDirection="Diverging" default="gateway-rawsfcode_01_end_line"></exclusiveGateway>
                            <sequenceFlow id="rawsfcode_01_gateway-rawsfcode_01_gatewayline" sourceRef="rawsfcode_01" targetRef="gateway-rawsfcode_01"></sequenceFlow>
