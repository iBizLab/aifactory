                    <sequenceFlow id="prepareparam_02_rawsfcode_01" sourceRef="prepareparam_02" targetRef="rawsfcode_01">
                    </sequenceFlow>
                    <sequenceFlow id="rawsfcode_01_end_01" sourceRef="rawsfcode_01" targetRef="end_01">
                    </sequenceFlow>
        </process>
