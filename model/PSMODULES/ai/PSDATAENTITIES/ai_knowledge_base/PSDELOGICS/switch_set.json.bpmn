                            <tns:global identifier="ai_knowledge_baseswitch_setmainpage" type="cn.ibizlab.core.ai.domain.ai_knowledge_base" />
            </extensionElements>
                        <startEvent id="begin" isInterrupting="true"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_knowledge_baseswitch_setdedataquery_01" id="dedataquery_01" implementation="http://www.jboss.org/drools/rule" name="当前选中知识库"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_knowledge_baseswitch_setprepareparam_01" id="prepareparam_01" implementation="http://www.jboss.org/drools/rule" name="只查询前100条"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_knowledge_baseswitch_setdedataset_01" id="dedataset_01" implementation="http://www.jboss.org/drools/rule" name="Main数据集"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_knowledge_baseswitch_setprepareparam_02" id="prepareparam_02" implementation="http://www.jboss.org/drools/rule" name="准备参数"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_knowledge_baseswitch_setrawsfcode_01" id="rawsfcode_01" implementation="http://www.jboss.org/drools/rule" name="执行脚本代码"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_knowledge_baseswitch_setend_01" id="end_01" implementation="http://www.jboss.org/drools/rule" name="结束"/>
                        <endEvent id="end_01_end" name="end"/>
                        <sequenceFlow id="end_01_end_line" sourceRef="end_01" targetRef="end_01_end"/>
                    <sequenceFlow id="begin_dedataquery_01" sourceRef="begin" targetRef="dedataquery_01">
