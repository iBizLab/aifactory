<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
    <definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:activiti="http://activiti.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:g="http://www.jboss.org/drools/flow/gpd" xmlns:tns="http://www.jboss.org/drools" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" expressionLanguage="http://www.mvel.org/2.0" id="Definition" name="" targetNamespace="http://www.jboss.org/drools" typeLanguage="http://www.java.com/javaTypes">
        <process id="cn.ibizlab.core.ai.service.logic.ai_knowledge_basecreate_member" isClosed="false" isExecutable="true" name="ai_ai_knowledge_base_create_member_ruleFlow" processType="Private" tns:packageName="cn.ibizlab.core.ai.service.logic.ai_knowledge_basecreate_member">
            <extensionElements>
                <tns:import name="java.util.Map" />
                <tns:import name="org.springframework.util.StringUtils"/>
                <tns:import name="cn.ibizlab.util.helper.RuleUtils"/>
                                <tns:metaData express="" name="ai_knowledge_basecreate_memberdefault" type="entity"/>
                                <tns:metaData express="new cn.ibizlab.core.ai.domain.ai_kb_member()" name="ai_knowledge_basecreate_memberai_kb_member" type="refentity"/>
                                    <tns:metaData express="T(cn.ibizlab.util.security.SpringContextHolder).getBean(T(cn.ibizlab.core.ai.service.Iai_kb_memberService))" name="ai_kb_memberservice" type="service"/>
                    <tns:metaData express="T(cn.ibizlab.util.security.SpringContextHolder).getBean(T(cn.ibizlab.core.ai.service.Iai_knowledge_baseService))" name="iBzSysAi_knowledge_baseDefaultService" type="service"/>
                    <tns:metaData express="T(cn.ibizlab.util.security.AuthenticationUser).getAuthenticationUser()" name="curuser" type="session"/>
                            <tns:global identifier="ai_knowledge_basecreate_memberdefault" type="cn.ibizlab.core.ai.domain.ai_knowledge_base" />
                            <tns:global identifier="ai_knowledge_basecreate_memberai_kb_member" type="cn.ibizlab.core.ai.domain.ai_kb_member" />
            </extensionElements>
                        <startEvent id="begin" isInterrupting="true"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_knowledge_basecreate_memberprepareparam_01" id="prepareparam_01" implementation="http://www.jboss.org/drools/rule" name="设置成员信息"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_knowledge_basecreate_memberdeaction_01" id="deaction_01" implementation="http://www.jboss.org/drools/rule" name="创建默认成员"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_knowledge_basecreate_memberend_01" id="end_01" implementation="http://www.jboss.org/drools/rule" name="结束"/>
                        <endEvent id="end_01_end" name="end"/>
                        <sequenceFlow id="end_01_end_line" sourceRef="end_01" targetRef="end_01_end"/>
                    <sequenceFlow id="begin_prepareparam_01" sourceRef="begin" targetRef="prepareparam_01">
                    </sequenceFlow>
                    <sequenceFlow id="gateway-prepareparam_01_deaction_01" sourceRef="gateway-prepareparam_01" targetRef="deaction_01">
                            <conditionExpression  language="http://www.jboss.org/drools/rule" ><![CDATA[
                                            $ai_knowledge_basecreate_memberdefault:ai_knowledge_base();
                                            $ai_knowledge_basecreate_memberai_kb_member:ai_kb_member();
                                    eval($ai_knowledge_basecreate_memberdefault==ai_knowledge_basecreate_memberdefault && $ai_knowledge_basecreate_memberai_kb_member==ai_knowledge_basecreate_memberai_kb_member);
                                eval((RuleUtils.test($ai_knowledge_basecreate_memberai_kb_member.get("userId"),"NOTEQ","aibizhi")))
                                ]]>
                            </conditionExpression>
                    </sequenceFlow>
                    <sequenceFlow id="deaction_01_end_01" sourceRef="deaction_01" targetRef="end_01">
                    </sequenceFlow>
                            <exclusiveGateway id="gateway-prepareparam_01" name="Gateway" gatewayDirection="Diverging" default="gateway-prepareparam_01_end_line"></exclusiveGateway>
                            <sequenceFlow id="prepareparam_01_gateway-prepareparam_01_gatewayline" sourceRef="prepareparam_01" targetRef="gateway-prepareparam_01"></sequenceFlow>
                            <sequenceFlow id="gateway-prepareparam_01_end_line" sourceRef="gateway-prepareparam_01" targetRef="gateway-prepareparam_01_end"/>
                            <endEvent id="gateway-prepareparam_01_end" name="end"/>
        </process>
    </definitions>