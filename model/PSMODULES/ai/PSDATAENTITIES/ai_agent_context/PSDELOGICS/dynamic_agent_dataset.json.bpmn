<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
    <definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:activiti="http://activiti.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:g="http://www.jboss.org/drools/flow/gpd" xmlns:tns="http://www.jboss.org/drools" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" expressionLanguage="http://www.mvel.org/2.0" id="Definition" name="" targetNamespace="http://www.jboss.org/drools" typeLanguage="http://www.java.com/javaTypes">
        <process id="cn.ibizlab.core.ai.service.logic.ai_agent_contextdynamic_agent_dataset" isClosed="false" isExecutable="true" name="ai_ai_agent_context_dynamic_agent_dataset_ruleFlow" processType="Private" tns:packageName="cn.ibizlab.core.ai.service.logic.ai_agent_contextdynamic_agent_dataset">
            <extensionElements>
                <tns:import name="java.util.Map" />
                <tns:import name="org.springframework.util.StringUtils"/>
                <tns:import name="cn.ibizlab.util.helper.RuleUtils"/>
                                <tns:metaData express="" name="ai_agent_contextdynamic_agent_datasetdefault" type="entity"/>
                                <tns:metaData express="new cn.ibizlab.core.ai.domain.ai_agent_context()" name="ai_agent_contextdynamic_agent_datasetitem" type="refentity"/>
                                <tns:metaData express="new cn.ibizlab.core.ai.domain.ai_agent_context()" name="ai_agent_contextdynamic_agent_datasetpage" type="refentity"/>
                                    <tns:metaData express="T(cn.ibizlab.util.security.SpringContextHolder).getBean(T(cn.ibizlab.core.ai.service.Iai_agent_contextService))" name="ai_agent_contextservice" type="service"/>
                    <tns:metaData express="T(cn.ibizlab.util.security.SpringContextHolder).getBean(T(cn.ibizlab.core.ai.service.Iai_agent_contextService))" name="iBzSysAi_agent_contextDefaultService" type="service"/>
                    <tns:metaData express="T(cn.ibizlab.util.security.AuthenticationUser).getAuthenticationUser()" name="curuser" type="session"/>
                            <tns:global identifier="ai_agent_contextdynamic_agent_datasetdefault" type="cn.ibizlab.core.ai.domain.ai_agent_context" />
                            <tns:global identifier="ai_agent_contextdynamic_agent_datasetitem" type="cn.ibizlab.core.ai.domain.ai_agent_context" />
                            <tns:global identifier="ai_agent_contextdynamic_agent_datasetpage" type="cn.ibizlab.core.ai.domain.ai_agent_context" />
            </extensionElements>
                        <startEvent id="begin" isInterrupting="true"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_contextdynamic_agent_datasetprepareparam_01" id="prepareparam_01" implementation="http://www.jboss.org/drools/rule" name="准备参数"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_contextdynamic_agent_datasetdedataset_01" id="dedataset_01" implementation="http://www.jboss.org/drools/rule" name="实体数据集"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_contextdynamic_agent_datasetloopsubcall_01" id="loopsubcall_01" implementation="http://www.jboss.org/drools/rule" name="循环子调用"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_contextdynamic_agent_datasetprepareparam_02" id="prepareparam_02" implementation="http://www.jboss.org/drools/rule" name="准备参数"/>
                        <endEvent id="prepareparam_02_end" name="end"/>
                        <sequenceFlow id="prepareparam_02_end_line" sourceRef="prepareparam_02" targetRef="prepareparam_02_end"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_contextdynamic_agent_datasetend_01" id="end_01" implementation="http://www.jboss.org/drools/rule" name="结束"/>
                        <endEvent id="end_01_end" name="end"/>
                        <sequenceFlow id="end_01_end_line" sourceRef="end_01" targetRef="end_01_end"/>
                    <sequenceFlow id="begin_prepareparam_01" sourceRef="begin" targetRef="prepareparam_01">
                    </sequenceFlow>
                    <sequenceFlow id="prepareparam_01_dedataset_01" sourceRef="prepareparam_01" targetRef="dedataset_01">
                    </sequenceFlow>
                    <sequenceFlow id="dedataset_01_loopsubcall_01" sourceRef="dedataset_01" targetRef="loopsubcall_01">
                    </sequenceFlow>
                    <sequenceFlow id="gateway-loopsubcall_01_prepareparam_02" sourceRef="gateway-loopsubcall_01" targetRef="prepareparam_02">
                            <conditionExpression  language="http://www.jboss.org/drools/rule" ><![CDATA[
                                            $ai_agent_contextdynamic_agent_datasetdefault:ai_agent_context();
                                            $ai_agent_contextdynamic_agent_datasetitem:ai_agent_context();
                                            $ai_agent_contextdynamic_agent_datasetpage:ai_agent_context();
                                    eval($ai_agent_contextdynamic_agent_datasetdefault==ai_agent_contextdynamic_agent_datasetdefault && $ai_agent_contextdynamic_agent_datasetitem==ai_agent_contextdynamic_agent_datasetitem && $ai_agent_contextdynamic_agent_datasetpage==ai_agent_contextdynamic_agent_datasetpage);
                                eval(((RuleUtils.test($ai_agent_contextdynamic_agent_datasetitem.get("useFulltext"),"EQ","1"))||(RuleUtils.test($ai_agent_contextdynamic_agent_datasetitem.get("deepResearch"),"EQ","1"))||(RuleUtils.test($ai_agent_contextdynamic_agent_datasetitem.get("specKbId"),"ISNOTNULL",""))))
                                ]]>
                            </conditionExpression>
                    </sequenceFlow>
                    <sequenceFlow id="loopsubcall_01_end_01" sourceRef="loopsubcall_01" targetRef="end_01">
                    </sequenceFlow>
                            <exclusiveGateway id="gateway-loopsubcall_01" name="Gateway" gatewayDirection="Diverging" default="gateway-loopsubcall_01_end_line"></exclusiveGateway>
                            <sequenceFlow id="loopsubcall_01_gateway-loopsubcall_01_gatewayline" sourceRef="loopsubcall_01" targetRef="gateway-loopsubcall_01"></sequenceFlow>
                            <sequenceFlow id="gateway-loopsubcall_01_end_line" sourceRef="gateway-loopsubcall_01" targetRef="gateway-loopsubcall_01_end"/>
                            <endEvent id="gateway-loopsubcall_01_end" name="end"/>
        </process>
    </definitions>