<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
    <definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:activiti="http://activiti.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:g="http://www.jboss.org/drools/flow/gpd" xmlns:tns="http://www.jboss.org/drools" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" expressionLanguage="http://www.mvel.org/2.0" id="Definition" name="" targetNamespace="http://www.jboss.org/drools" typeLanguage="http://www.java.com/javaTypes">
        <process id="cn.ibizlab.core.ai.service.logic.ai_agent_contextbatch_execution" isClosed="false" isExecutable="true" name="ai_ai_agent_context_batch_execution_ruleFlow" processType="Private" tns:packageName="cn.ibizlab.core.ai.service.logic.ai_agent_contextbatch_execution">
            <extensionElements>
                <tns:import name="java.util.Map" />
                <tns:import name="org.springframework.util.StringUtils"/>
                <tns:import name="cn.ibizlab.util.helper.RuleUtils"/>
                                <tns:metaData express="" name="ai_agent_contextbatch_executiondefault" type="entity"/>
                                <tns:metaData express="new cn.ibizlab.core.ai.domain.ai_knowledge_base()" name="ai_agent_contextbatch_executionkb_list" type="refentity"/>
                                <tns:metaData express="new cn.ibizlab.core.ai.domain.ai_knowledge_base()" name="ai_agent_contextbatch_executionkb_temp" type="refentity"/>
                                    <tns:metaData express="T(cn.ibizlab.util.security.SpringContextHolder).getBean(T(cn.ibizlab.core.ai.service.Iai_knowledge_baseService))" name="ai_knowledge_baseservice" type="service"/>
                    <tns:metaData express="T(cn.ibizlab.util.security.SpringContextHolder).getBean(T(cn.ibizlab.core.ai.service.Iai_agent_contextService))" name="iBzSysAi_agent_contextDefaultService" type="service"/>
                    <tns:metaData express="T(cn.ibizlab.util.security.AuthenticationUser).getAuthenticationUser()" name="curuser" type="session"/>
                            <tns:global identifier="ai_agent_contextbatch_executiondefault" type="cn.ibizlab.core.ai.domain.ai_agent_context" />
                            <tns:global identifier="ai_agent_contextbatch_executionkb_list" type="cn.ibizlab.core.ai.domain.ai_knowledge_base" />
                            <tns:global identifier="ai_agent_contextbatch_executionkb_temp" type="cn.ibizlab.core.ai.domain.ai_knowledge_base" />
            </extensionElements>
                        <startEvent id="begin" isInterrupting="true"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_contextbatch_executiondeaction_01" id="deaction_01" implementation="http://www.jboss.org/drools/rule" name="知识库推理"/>
                        <endEvent id="deaction_01_end" name="end"/>
                        <sequenceFlow id="deaction_01_end_line" sourceRef="deaction_01" targetRef="deaction_01_end"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_contextbatch_executionrawsfcode_01" id="rawsfcode_01" implementation="http://www.jboss.org/drools/rule" name="解析所选择的知识库"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_contextbatch_executionprepareparam_01" id="prepareparam_01" implementation="http://www.jboss.org/drools/rule" name="准备参数"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_contextbatch_executiondelogic_01" id="delogic_01" implementation="http://www.jboss.org/drools/rule" name="知识库研究"/>
                        <endEvent id="delogic_01_end" name="end"/>
                        <sequenceFlow id="delogic_01_end_line" sourceRef="delogic_01" targetRef="delogic_01_end"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_contextbatch_executionloopsubcall_01" id="loopsubcall_01" implementation="http://www.jboss.org/drools/rule" name="循环子调用"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_contextbatch_executiondelogic_02" id="delogic_02" implementation="http://www.jboss.org/drools/rule" name="知识库全文推理"/>
                        <endEvent id="delogic_02_end" name="end"/>
                        <sequenceFlow id="delogic_02_end_line" sourceRef="delogic_02" targetRef="delogic_02_end"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_contextbatch_executionend_01" id="end_01" implementation="http://www.jboss.org/drools/rule" name="结束"/>
                        <endEvent id="end_01_end" name="end"/>
                        <sequenceFlow id="end_01_end_line" sourceRef="end_01" targetRef="end_01_end"/>
                    <sequenceFlow id="begin_rawsfcode_01" sourceRef="begin" targetRef="rawsfcode_01">
                    </sequenceFlow>
                    <sequenceFlow id="gateway-rawsfcode_01_loopsubcall_01" sourceRef="gateway-rawsfcode_01" targetRef="loopsubcall_01">
                            <conditionExpression  language="http://www.jboss.org/drools/rule" ><![CDATA[
                                            $ai_agent_contextbatch_executiondefault:ai_agent_context();
                                            $ai_agent_contextbatch_executionkb_list:ai_knowledge_base();
                                            $ai_agent_contextbatch_executionkb_temp:ai_knowledge_base();
                                    eval($ai_agent_contextbatch_executiondefault==ai_agent_contextbatch_executiondefault && $ai_agent_contextbatch_executionkb_list==ai_agent_contextbatch_executionkb_list && $ai_agent_contextbatch_executionkb_temp==ai_agent_contextbatch_executionkb_temp);
                                eval((RuleUtils.test($ai_agent_contextbatch_executionkb_list.get("size"),"GT","0")))
                                ]]>
                            </conditionExpression>
                    </sequenceFlow>
                    <sequenceFlow id="gateway-rawsfcode_01_end_01" sourceRef="gateway-rawsfcode_01" targetRef="end_01">
                            <conditionExpression  language="http://www.jboss.org/drools/rule" ><![CDATA[
                                            $ai_agent_contextbatch_executiondefault:ai_agent_context();
                                            $ai_agent_contextbatch_executionkb_list:ai_knowledge_base();
                                            $ai_agent_contextbatch_executionkb_temp:ai_knowledge_base();
                                    eval($ai_agent_contextbatch_executiondefault==ai_agent_contextbatch_executiondefault && $ai_agent_contextbatch_executionkb_list==ai_agent_contextbatch_executionkb_list && $ai_agent_contextbatch_executionkb_temp==ai_agent_contextbatch_executionkb_temp);
                                eval((RuleUtils.test($ai_agent_contextbatch_executionkb_list.get("size"),"EQ","0")))
                                ]]>
                            </conditionExpression>
                    </sequenceFlow>
                    <sequenceFlow id="gateway-prepareparam_01_deaction_01" sourceRef="gateway-prepareparam_01" targetRef="deaction_01">
                            <conditionExpression  language="http://www.jboss.org/drools/rule" ><![CDATA[
                                            $ai_agent_contextbatch_executiondefault:ai_agent_context();
                                            $ai_agent_contextbatch_executionkb_list:ai_knowledge_base();
                                            $ai_agent_contextbatch_executionkb_temp:ai_knowledge_base();
                                    eval($ai_agent_contextbatch_executiondefault==ai_agent_contextbatch_executiondefault && $ai_agent_contextbatch_executionkb_list==ai_agent_contextbatch_executionkb_list && $ai_agent_contextbatch_executionkb_temp==ai_agent_contextbatch_executionkb_temp);
                                eval((RuleUtils.test($ai_agent_contextbatch_executiondefault.get("deepResearch"),"EQ","0")))
                                ]]>
                            </conditionExpression>
                    </sequenceFlow>
                    <sequenceFlow id="gateway-prepareparam_01_delogic_01" sourceRef="gateway-prepareparam_01" targetRef="delogic_01">
                            <conditionExpression  language="http://www.jboss.org/drools/rule" ><![CDATA[
                                            $ai_agent_contextbatch_executiondefault:ai_agent_context();
                                            $ai_agent_contextbatch_executionkb_list:ai_knowledge_base();
                                            $ai_agent_contextbatch_executionkb_temp:ai_knowledge_base();
                                    eval($ai_agent_contextbatch_executiondefault==ai_agent_contextbatch_executiondefault && $ai_agent_contextbatch_executionkb_list==ai_agent_contextbatch_executionkb_list && $ai_agent_contextbatch_executionkb_temp==ai_agent_contextbatch_executionkb_temp);
                                eval((RuleUtils.test($ai_agent_contextbatch_executiondefault.get("deepResearch"),"EQ","1")))
                                ]]>
                            </conditionExpression>
                    </sequenceFlow>
                    <sequenceFlow id="gateway-prepareparam_01_delogic_02" sourceRef="gateway-prepareparam_01" targetRef="delogic_02">
                            <conditionExpression  language="http://www.jboss.org/drools/rule" ><![CDATA[
                                            $ai_agent_contextbatch_executiondefault:ai_agent_context();
                                            $ai_agent_contextbatch_executionkb_list:ai_knowledge_base();
                                            $ai_agent_contextbatch_executionkb_temp:ai_knowledge_base();
                                    eval($ai_agent_contextbatch_executiondefault==ai_agent_contextbatch_executiondefault && $ai_agent_contextbatch_executionkb_list==ai_agent_contextbatch_executionkb_list && $ai_agent_contextbatch_executionkb_temp==ai_agent_contextbatch_executionkb_temp);
                                eval((RuleUtils.test($ai_agent_contextbatch_executiondefault.get("deepResearch"),"EQ","2")))
                                ]]>
                            </conditionExpression>
                    </sequenceFlow>
                    <sequenceFlow id="loopsubcall_01_prepareparam_01" sourceRef="loopsubcall_01" targetRef="prepareparam_01">
                    </sequenceFlow>
                    <sequenceFlow id="loopsubcall_01_end_01" sourceRef="loopsubcall_01" targetRef="end_01">
                    </sequenceFlow>
                            <exclusiveGateway id="gateway-rawsfcode_01" name="Gateway" gatewayDirection="Diverging" default="gateway-rawsfcode_01_end_line"></exclusiveGateway>
                            <sequenceFlow id="rawsfcode_01_gateway-rawsfcode_01_gatewayline" sourceRef="rawsfcode_01" targetRef="gateway-rawsfcode_01"></sequenceFlow>
                            <sequenceFlow id="gateway-rawsfcode_01_end_line" sourceRef="gateway-rawsfcode_01" targetRef="gateway-rawsfcode_01_end"/>
                            <endEvent id="gateway-rawsfcode_01_end" name="end"/>
                            <exclusiveGateway id="gateway-prepareparam_01" name="Gateway" gatewayDirection="Diverging" default="gateway-prepareparam_01_end_line"></exclusiveGateway>
                            <sequenceFlow id="prepareparam_01_gateway-prepareparam_01_gatewayline" sourceRef="prepareparam_01" targetRef="gateway-prepareparam_01"></sequenceFlow>
                            <sequenceFlow id="gateway-prepareparam_01_end_line" sourceRef="gateway-prepareparam_01" targetRef="gateway-prepareparam_01_end"/>
                            <endEvent id="gateway-prepareparam_01_end" name="end"/>
        </process>
    </definitions>