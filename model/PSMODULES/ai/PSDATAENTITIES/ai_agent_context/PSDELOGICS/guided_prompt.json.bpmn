        <process id="cn.ibizlab.core.ai.service.logic.ai_agent_contextguided_prompt" isClosed="false" isExecutable="true" name="ai_ai_agent_context_guided_prompt_ruleFlow" processType="Private" tns:packageName="cn.ibizlab.core.ai.service.logic.ai_agent_contextguided_prompt">
