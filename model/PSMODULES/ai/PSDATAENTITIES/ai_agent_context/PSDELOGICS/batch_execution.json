    "code" : "def _defualt = logic.param('Default').getReal()\r\ndef kb_list = logic.param('kb_list').getReal()\r\ndef kb_ids = _defualt.get('kb_ids')\r\nif(kb_ids) {\r\n    def kb_runtime = sys.dataentity('AI_KNOWLEDGE_BASE')\r\n    def kbs = null\r\n    // 情况1：kb_ids是字符串形式的json数组，如 \"[{\\\"id\\\":\\\"1\\\"},{\\\"id\\\":\\\"2\\\"}]\"\r\n    // 情况2：kb_ids本身就是json数组(List)\r\n    // 情况3：kb_ids是逗号分隔的id字符串，如 \"1,2,3\"\r\n    if (kb_ids instanceof String) {\r\n        def str = kb_ids.trim()\r\n        if (str.startsWith('[')) {\r\n            // 情况1：字符串形式的json数组\r\n            kbs = new groovy.json.JsonSlurper().parseText(str)\r\n        } else {\r\n            // 情况3：逗号分隔的id字符串\r\n            kbs = str.split(',').collect { it.trim() }.findAll { it }\r\n        }\r\n    } else if (kb_ids instanceof List) {\r\n        // 情况2：本身就是json数组(List)\r\n        kbs = kb_ids\r\n    }\r\n    if (kbs && kbs.size() > 0) {\r\n        kbs.each { it ->\r\n            def kb = kb_runtime.entity()\r\n            // 兼容元素为Map（含id属性）或直接为id字符串两种情况\r\n            def id = (it instanceof Map) ? it.get('id') : it\r\n            kb.set('id', id)\r\n            kb.set('agenttag', _defualt.get('code_name'))\r\n            kb_list.add(kb)\r\n        }\r\n    }\r\n}",
