package cn.ibizlab.ai.logic.ai_agent_conversationlogic.clear_message;
        import java.util.Map;
        import java.util.HashMap;
        import com.alibaba.fastjson.JSONObject;
        import org.springframework.util.StringUtils;
        import org.springframework.util.ObjectUtils;
        import cn.ibizlab.util.errors.BadRequestAlertException;
                global cn.ibizlab.core.ai.domain.ai_agent_conversation ai_agent_conversationclear_messagedefault;
                    global cn.ibizlab.core.ai.service.Iai_agent_conversationService ai_agent_conversationservice;
        global cn.ibizlab.core.ai.service.Iai_agent_conversationService iBzSysAi_agent_conversationDefaultService;
        global cn.ibizlab.util.security.AuthenticationUser curuser;


    no-loop

            //逻辑处理节点[开始]
            rule "begin"
            ruleflow-group "ai_agent_conversationclear_messagebegin"
            when
            then
            end

            //逻辑处理节点[获取会话]
            rule "deaction_01"
            ruleflow-group "ai_agent_conversationclear_messagedeaction_01"
            when
            then
                            cn.ibizlab.util.helper.CachedBeanCopier.copy(ai_agent_conversationservice.get(ai_agent_conversationclear_messagedefault.getId()),ai_agent_conversationclear_messagedefault);
                        update(ai_agent_conversationclear_messagedefault);//更新fact中变量值
            end

            //逻辑处理节点[直接sql调用]
            rule "rawsqlcall_01"
            ruleflow-group "ai_agent_conversationclear_messagerawsqlcall_01"
            when
            then
    Map param =new HashMap();
        param.put("param0",ai_agent_conversationclear_messagedefault.get("sessionid"));
        param.put("param1",ai_agent_conversationclear_messagedefault.get("id"));
    String strSql="DELETE FROM AI_AGENT_MESSAGE WHERE CONVERSATION_ID IN (SELECT ID FROM AI_AGENT_CONVERSATION WHERE SESSION_ID = #{et.param0}); DELETE  FROM AI_AGENT_FEEDBACK WHERE CONVERSATION_ID = #{et.param1} ; ";
                        iBzSysAi_agent_conversationDefaultService.execute(strSql,param);//SQL调用
                        update(ai_agent_conversationclear_messagedefault);//更新fact中变量值
            end

            //逻辑处理节点[结束]
            rule "end_01"
            ruleflow-group "ai_agent_conversationclear_messageend_01"
            when
            then
                        update(ai_agent_conversationclear_messagedefault);//更新fact中变量值
            end