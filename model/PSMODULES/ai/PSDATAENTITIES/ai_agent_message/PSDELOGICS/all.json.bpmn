                                <tns:metaData express="new cn.ibizlab.core.ai.domain.ai_agent_message()" name="ai_agent_messageallresult" type="refentity"/>
                                <tns:metaData express="new HashMap()" name="ai_agent_messageallsizeval" type="refentity"/>
                                    <tns:metaData express="T(cn.ibizlab.util.security.SpringContextHolder).getBean(T(cn.ibizlab.core.ai.service.Iai_agent_messageService))" name="ai_agent_messageservice" type="service"/>
                    <tns:metaData express="T(cn.ibizlab.util.security.SpringContextHolder).getBean(T(cn.ibizlab.core.ai.service.Iai_agent_messageService))" name="iBzSysAi_agent_messageDefaultService" type="service"/>
                    <tns:metaData express="T(cn.ibizlab.util.security.AuthenticationUser).getAuthenticationUser()" name="curuser" type="session"/>
                            <tns:global identifier="ai_agent_messagealldefault" type="cn.ibizlab.core.ai.domain.ai_agent_message" />
                            <tns:global identifier="ai_agent_messageallfilter" type="cn.ibizlab.core.ai.domain.ai_agent_message" />
