                            <tns:global identifier="ai_agent_messageallresult" type="cn.ibizlab.core.ai.domain.ai_agent_message" />
            </extensionElements>
                        <startEvent id="begin" isInterrupting="true"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_messagealldedataquery_01" id="dedataquery_01" implementation="http://www.jboss.org/drools/rule" name="实体数据查询"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_messageallsortparam_01" id="sortparam_01" implementation="http://www.jboss.org/drools/rule" name="按消息序号正序排序"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_messageallrawsfcode_02" id="rawsfcode_02" implementation="http://www.jboss.org/drools/rule" name="按传入size及page截取列表"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_messageallcopyparam_01" id="copyparam_01" implementation="http://www.jboss.org/drools/rule" name="拷贝Default过滤器属性到filter"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_messageallprepareparam_01" id="prepareparam_01" implementation="http://www.jboss.org/drools/rule" name="保存传入分页参数并设置查询条件"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_messageallend_01" id="end_01" implementation="http://www.jboss.org/drools/rule" name="结束"/>
                        <endEvent id="end_01_end" name="end"/>
                        <sequenceFlow id="end_01_end_line" sourceRef="end_01" targetRef="end_01_end"/>
                    <sequenceFlow id="begin_copyparam_01" sourceRef="begin" targetRef="copyparam_01">
