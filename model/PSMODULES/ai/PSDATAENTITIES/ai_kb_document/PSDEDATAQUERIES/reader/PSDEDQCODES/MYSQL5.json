  "queryCode" : "SELECT\nt1.`ACTIVE`,\nt1.`CATEGORIES`,\nt1.`CHUNK_METHOD`,\nt1.`CHUNK_NUM`,\nt1.`CREATE_MAN`,\nt1.`CREATE_TIME`,\nt1.`CUSTOM_CHUNK`,\nt1.`DIGEST_CODE`,\nTO_CHAR(t1.`CREATE_TIME`, 'YYYY-MM-DD') AS `DOC_CREATE_TIME`,\nt1.`FILE`,\nt1.`FILE_TYPE`,\nt1.`ID`,\nt1.`KB_ID`,\nt11.`NAME` AS `KB_NAME`,\nt1.`KEY`,\nt1.`NAME`,\nconcat_ws('/',nullif(btrim(t1.`CATEGORIES`, '/'),''),t1.`NAME`||'.'||COALESCE(t1.`FILE_TYPE`,'md')) AS `PATH`,\nCURRENT_DATE - t1.`CREATE_TIME`::date AS `RECENT_CREATE_DAYS`,\nt1.`RESOURCE`,\nt1.`SEQUENCE`,\nt1.`SIZE`,\nt1.`SOURCE_ID`,\nt1.`SOURCE_TYPE`,\nt1.`STATUS`,\nt1.`SYNC_FREQUENCY`,\nt1.`SYNC_ID`,\nt11.`TAG_SETS`,\nt1.`TYPE`,\nt1.`UPDATE_MAN`,\nt1.`UPDATE_TIME`,\nt1.`USER_TAG`,\nt1.`USER_TAG2`\nFROM `AI_KB_DOCUMENT` t1 \nLEFT JOIN `AI_KNOWLEDGE_BASE` t11 ON t1.`KB_ID` = t11.`ID` \n",
  "id" : "PSMODULES/ai/PSDATAENTITIES/ai_kb_document/PSDEDATAQUERIES/reader/PSDEDQCODES/MYSQL5.json"
