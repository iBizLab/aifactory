<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
    <definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:activiti="http://activiti.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:g="http://www.jboss.org/drools/flow/gpd" xmlns:tns="http://www.jboss.org/drools" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" expressionLanguage="http://www.mvel.org/2.0" id="Definition" name="" targetNamespace="http://www.jboss.org/drools" typeLanguage="http://www.java.com/javaTypes">
        <process id="cn.ibizlab.core.ai.service.logic.ai_agent_assignmentregister" isClosed="false" isExecutable="true" name="ai_ai_agent_assignment_register_ruleFlow" processType="Private" tns:packageName="cn.ibizlab.core.ai.service.logic.ai_agent_assignmentregister">
            <extensionElements>
                <tns:import name="java.util.Map" />
                <tns:import name="org.springframework.util.StringUtils"/>
                <tns:import name="cn.ibizlab.util.helper.RuleUtils"/>
                                <tns:metaData express="" name="ai_agent_assignmentregisterdefault" type="entity"/>
                                <tns:metaData express="new HashMap()" name="ai_agent_assignmentregisterncheck" type="refentity"/>
                                    <tns:metaData express="T(cn.ibizlab.util.security.SpringContextHolder).getBean(T(cn.ibizlab.core.ai.service.Iai_agent_assignmentService))" name="ai_agent_assignmentservice" type="service"/>
                    <tns:metaData express="T(cn.ibizlab.util.security.SpringContextHolder).getBean(T(cn.ibizlab.core.ai.service.Iai_agent_assignmentService))" name="iBzSysAi_agent_assignmentDefaultService" type="service"/>
                    <tns:metaData express="T(cn.ibizlab.util.security.AuthenticationUser).getAuthenticationUser()" name="curuser" type="session"/>
                            <tns:global identifier="ai_agent_assignmentregisterdefault" type="cn.ibizlab.core.ai.domain.ai_agent_assignment" />
            </extensionElements>
                        <startEvent id="begin" isInterrupting="true"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_assignmentregisterdeaction_01" id="deaction_01" implementation="http://www.jboss.org/drools/rule" name="checkkey"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_assignmentregisterdeaction_02" id="deaction_02" implementation="http://www.jboss.org/drools/rule" name="create"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_assignmentregisterdeaction_03" id="deaction_03" implementation="http://www.jboss.org/drools/rule" name="实体行为"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_agent_assignmentregisterend_01" id="end_01" implementation="http://www.jboss.org/drools/rule" name="结束"/>
                        <endEvent id="end_01_end" name="end"/>
                        <sequenceFlow id="end_01_end_line" sourceRef="end_01" targetRef="end_01_end"/>
                    <sequenceFlow id="begin_deaction_01" sourceRef="begin" targetRef="deaction_01">
                    </sequenceFlow>
                    <sequenceFlow id="gateway-deaction_01_deaction_02" sourceRef="gateway-deaction_01" targetRef="deaction_02">
                            <conditionExpression  language="http://www.jboss.org/drools/rule" ><![CDATA[
                                            $ai_agent_assignmentregisterdefault:ai_agent_assignment();
                                            $ai_agent_assignmentregisterncheck:Map();
                                    eval($ai_agent_assignmentregisterdefault==ai_agent_assignmentregisterdefault && );
                                eval((RuleUtils.test($ai_agent_assignmentregisterncheck.get(""),"EQ","0")))
                                ]]>
                            </conditionExpression>
                    </sequenceFlow>
                    <sequenceFlow id="deaction_01_deaction_03" sourceRef="deaction_01" targetRef="deaction_03">
                    </sequenceFlow>
                    <sequenceFlow id="deaction_02_end_01" sourceRef="deaction_02" targetRef="end_01">
                    </sequenceFlow>
                    <sequenceFlow id="deaction_03_end_01" sourceRef="deaction_03" targetRef="end_01">
                    </sequenceFlow>
                            <exclusiveGateway id="gateway-deaction_01" name="Gateway" gatewayDirection="Diverging" default="gateway-deaction_01_end_line"></exclusiveGateway>
                            <sequenceFlow id="deaction_01_gateway-deaction_01_gatewayline" sourceRef="deaction_01" targetRef="gateway-deaction_01"></sequenceFlow>
                            <sequenceFlow id="gateway-deaction_01_end_line" sourceRef="gateway-deaction_01" targetRef="gateway-deaction_01_end"/>
                            <endEvent id="gateway-deaction_01_end" name="end"/>
        </process>
