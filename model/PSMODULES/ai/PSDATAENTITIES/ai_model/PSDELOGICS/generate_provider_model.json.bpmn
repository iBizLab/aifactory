                                eval((RuleUtils.test($ai_modelgenerate_provider_modeldefault.get("default_token"),"ISNOTNULL","")))
                                ]]>
                            </conditionExpression>
                    </sequenceFlow>
                    <sequenceFlow id="gateway-resetparam_01_prepareparam_02" sourceRef="gateway-resetparam_01" targetRef="prepareparam_02">
                            <conditionExpression  language="http://www.jboss.org/drools/rule" ><![CDATA[
                                            $ai_modelgenerate_provider_modeldefault:ai_model();
                                            $ai_modelgenerate_provider_modelai_models:ai_model();
                                            $ai_modelgenerate_provider_modelcreate_obj:ai_model();
