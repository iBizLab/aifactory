                            <exclusiveGateway id="gateway-bindparam_01" name="Gateway" gatewayDirection="Diverging" default="gateway-bindparam_01_end_line"></exclusiveGateway>
                            <sequenceFlow id="bindparam_01_gateway-bindparam_01_gatewayline" sourceRef="bindparam_01" targetRef="gateway-bindparam_01"></sequenceFlow>
