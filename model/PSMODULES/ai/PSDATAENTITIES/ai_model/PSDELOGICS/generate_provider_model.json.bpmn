            </extensionElements>
                        <startEvent id="begin" isInterrupting="true"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_modelgenerate_provider_modelbindparam_01" id="bindparam_01" implementation="http://www.jboss.org/drools/rule" name="获取选中模型"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_modelgenerate_provider_modeldedataset_01" id="dedataset_01" implementation="http://www.jboss.org/drools/rule" name="是否已存在该模型"/>
