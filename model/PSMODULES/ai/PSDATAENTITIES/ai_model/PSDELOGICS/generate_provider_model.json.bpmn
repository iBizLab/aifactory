                                eval((RuleUtils.test($ai_modelgenerate_provider_modelai_models.get("size"),"EQ","0")))
                                ]]>
                            </conditionExpression>
                    </sequenceFlow>
                    <sequenceFlow id="gateway-resetparam_01_prepareparam_03" sourceRef="gateway-resetparam_01" targetRef="prepareparam_03">
                            <conditionExpression  language="http://www.jboss.org/drools/rule" ><![CDATA[
