                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_modelgenerate_provider_modelprepareparam_03" id="prepareparam_03" implementation="http://www.jboss.org/drools/rule" name="设置凭证id"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_modelgenerate_provider_modelprepareparam_02" id="prepareparam_02" implementation="http://www.jboss.org/drools/rule" name="准备参数"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_modelgenerate_provider_modeldeaction_01" id="deaction_01" implementation="http://www.jboss.org/drools/rule" name="创建模型"/>
                        <endEvent id="deaction_01_end" name="end"/>
                        <sequenceFlow id="deaction_01_end_line" sourceRef="deaction_01" targetRef="deaction_01_end"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="ai_modelgenerate_provider_modelprepareparam_01" id="prepareparam_01" implementation="http://www.jboss.org/drools/rule" name="准备参数"/>
