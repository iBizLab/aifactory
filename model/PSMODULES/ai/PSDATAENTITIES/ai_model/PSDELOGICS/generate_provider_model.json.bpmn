                    <sequenceFlow id="gateway-bindparam_01_loopsubcall_01" sourceRef="gateway-bindparam_01" targetRef="loopsubcall_01">
                            <conditionExpression  language="http://www.jboss.org/drools/rule" ><![CDATA[
                                            $ai_modelgenerate_provider_modeldefault:ai_model();
                                            $ai_modelgenerate_provider_modelai_models:ai_model();
                                            $ai_modelgenerate_provider_modelcreate_obj:ai_model();
                                            $ai_modelgenerate_provider_modelmodel_filter:ai_model();
                                            $ai_modelgenerate_provider_modelsrfactionparam:Map();
                                            $ai_modelgenerate_provider_modeltemp_obj:Map();
                                    eval($ai_modelgenerate_provider_modeldefault==ai_modelgenerate_provider_modeldefault && $ai_modelgenerate_provider_modelai_models==ai_modelgenerate_provider_modelai_models && $ai_modelgenerate_provider_modelcreate_obj==ai_modelgenerate_provider_modelcreate_obj && $ai_modelgenerate_provider_modelmodel_filter==ai_modelgenerate_provider_modelmodel_filter && );
                                eval((RuleUtils.test($ai_modelgenerate_provider_modelsrfactionparam.get("length"),"GT","0")))
                                ]]>
