            </extensionElements>
                        <startEvent id="begin" isInterrupting="true"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="data_resourcefullbindparam_01" id="bindparam_01" implementation="http://www.jboss.org/drools/rule" name="将schema绑定至新对象"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="data_resourcefullprepareparam_01" id="prepareparam_01" implementation="http://www.jboss.org/drools/rule" name="填充DEFINITION"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="data_resourcefullend_01" id="end_01" implementation="http://www.jboss.org/drools/rule" name="结束"/>
                        <endEvent id="end_01_end" name="end"/>
                        <sequenceFlow id="end_01_end_line" sourceRef="end_01" targetRef="end_01_end"/>
