        <process id="cn.ibizlab.core.meta.service.logic.data_resourcefull" isClosed="false" isExecutable="true" name="meta_data_resource_full_ruleFlow" processType="Private" tns:packageName="cn.ibizlab.core.meta.service.logic.data_resourcefull">
