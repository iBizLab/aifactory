<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
    <definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:activiti="http://activiti.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:g="http://www.jboss.org/drools/flow/gpd" xmlns:tns="http://www.jboss.org/drools" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" expressionLanguage="http://www.mvel.org/2.0" id="Definition" name="" targetNamespace="http://www.jboss.org/drools" typeLanguage="http://www.java.com/javaTypes">
        <process id="cn.ibizlab.core.extension.service.logic.psdelogicpublishconfig" isClosed="false" isExecutable="true" name="extension_psdelogic_publishconfig_ruleFlow" processType="Private" tns:packageName="cn.ibizlab.core.extension.service.logic.psdelogicpublishconfig">
            <extensionElements>
                <tns:import name="java.util.Map" />
                <tns:import name="org.springframework.util.StringUtils"/>
                <tns:import name="cn.ibizlab.util.helper.RuleUtils"/>
                                <tns:metaData express="" name="psdelogicpublishconfigdefault" type="entity"/>
                                    <tns:metaData express="T(cn.ibizlab.util.security.SpringContextHolder).getBean(T(cn.ibizlab.core.extension.service.IPSDELogicService))" name="psdelogicservice" type="service"/>
                    <tns:metaData express="T(cn.ibizlab.util.security.SpringContextHolder).getBean(T(cn.ibizlab.core.extension.service.IPSDELogicService))" name="iBzSysPsdelogicDefaultService" type="service"/>
                    <tns:metaData express="T(cn.ibizlab.util.security.AuthenticationUser).getAuthenticationUser()" name="curuser" type="session"/>
                            <tns:global identifier="psdelogicpublishconfigdefault" type="cn.ibizlab.core.extension.domain.PSDELogic" />
            </extensionElements>
                        <startEvent id="begin" isInterrupting="true"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="psdelogicpublishconfigend_01" id="end_01" implementation="http://www.jboss.org/drools/rule" name="结束"/>
                        <endEvent id="end_01_end" name="end"/>
                        <sequenceFlow id="end_01_end_line" sourceRef="end_01" targetRef="end_01_end"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="psdelogicpublishconfigdeaction_01" id="deaction_01" implementation="http://www.jboss.org/drools/rule" name="获取逻辑数据"/>
                        <businessRuleTask activiti:exclusive="true" g:ruleFlowGroup="psdelogicpublishconfigrawsfcode_01" id="rawsfcode_01" implementation="http://www.jboss.org/drools/rule" name="发布配置"/>
                    <sequenceFlow id="begin_deaction_01" sourceRef="begin" targetRef="deaction_01">
                    </sequenceFlow>
                    <sequenceFlow id="gateway-deaction_01_rawsfcode_01" sourceRef="gateway-deaction_01" targetRef="rawsfcode_01">
                            <conditionExpression  language="http://www.jboss.org/drools/rule" ><![CDATA[
                                            $psdelogicpublishconfigdefault:PSDELogic();
                                    eval($psdelogicpublishconfigdefault==psdelogicpublishconfigdefault);
                                eval((RuleUtils.test($psdelogicpublishconfigdefault.get("logicsubtype"),"EQ","WEBHOOK"))&&(RuleUtils.test($psdelogicpublishconfigdefault.get("expirestime"),"ISNOTNULL","")))
                                ]]>
                            </conditionExpression>
                    </sequenceFlow>
                    <sequenceFlow id="rawsfcode_01_end_01" sourceRef="rawsfcode_01" targetRef="end_01">
                    </sequenceFlow>
                            <exclusiveGateway id="gateway-deaction_01" name="Gateway" gatewayDirection="Diverging" default="gateway-deaction_01_end_line"></exclusiveGateway>
                            <sequenceFlow id="deaction_01_gateway-deaction_01_gatewayline" sourceRef="deaction_01" targetRef="gateway-deaction_01"></sequenceFlow>
                            <sequenceFlow id="gateway-deaction_01_end_line" sourceRef="gateway-deaction_01" targetRef="gateway-deaction_01_end"/>
                            <endEvent id="gateway-deaction_01_end" name="end"/>
        </process>
    </definitions>