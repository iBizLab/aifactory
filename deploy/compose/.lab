## 业务系统配置信息
SYSTEM_NAME=ibizaifactory
SYSTEM_REPO=https://gitee.com/ibizlab/aifactory.git
SYSTEM_BRANCH=main
SYSTEM_RELOADMONITORINTERVAL=20000

# 镜像仓库：提供青云，阿里云、华为云国内加速镜像库。通过注释的方式切换镜像库
## 青云镜像库
##IMAGE_URL=dockerhub.qingcloud.com/ibizlab/
## 阿里云镜像库
##IMAGE_URL=registry.cn-shanghai.aliyuncs.com/1024find/
##华为云
##IMAGE_URL=swr.ap-southeast-1.myhuaweicloud.com/find1024/
##私有云
IMAGE_URL=image.ibizlab.cn/opensource/
